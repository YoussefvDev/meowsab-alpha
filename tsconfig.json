{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Path Aliases
    "baseUrl": ".",
    "paths": {
      "#check-buyers":  ["./src/core/socket/providers/check-buyers.ts"],
      "#check-premium": ["./src/core/socket/providers/check-premium.ts"],
      "#types":         ["./src/core/types/index.ts"],
      "#banners":       ["./src/core/banners/index.ts"],
      "#message":       ["./src/core/socket/message/index.ts"],
      "#session":       ["./src/session/index.ts"],
      "#helpers":       ["./src/core/helpers/index.ts"],
      "#listeners":     ["./src/core/listeners/index.ts"],
      "#sending":       ["./src/core/socket/sending/index.ts"],
      "#maker":         ["./src/core/socket/maker.ts"],
      "#hono":          ["./src/core/socket/providers/api.ts"],
      "#system":        ["./src/core/socket/providers/check-system.ts"],
      "#methods":       ["./src/core/socket/methods.ts"],
      "#index":         ["./src/index.ts"]
    },

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "moduleDetection": "force",

    // Other Outputs
    // "sourceMap": true,
    // "declaration": true,
    // "declarationMap": true,

    // Stricter Typechecking Options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    // "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}